# Nexus 环境变量模板
# 真值不提交！用各 Space 的 Secrets / Worker Secrets 注入。
# 复制为 .env 本地测试，.env 已 gitignore。

# ── Cloudflare R2 ──
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_CHECKPOINT_BUCKET=nexus-checkpoints

# ── Supabase ──
SUPABASE_URL=https://<id>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URI=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Hugging Face ──
HF_TOKEN=
SPACE_AUTHOR_NAME=
SPACE_REPO_NAME=

# ── Nexus 内部 ──
NEXUS_API_KEY=
GATEWAY_URL=
LANGGRAPH_URL=https://<owner>-langgraph.hf.space
CLAUDE_URL=https://<owner>-claude-code.hf.space
CODEX_URL=https://<owner>-codex.hf.space

# ── 下游模型（各 Space 按需）──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-4o-mini
