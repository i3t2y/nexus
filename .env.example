# Nexus 环境变量模板
# 真值不提交！用各 Space 的 Secrets / Worker Secrets 注入。
# 复制为 .env 本地测试，.env 已 gitignore。

# ── Cloudflare R2 ──
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# 各桶（Cloudflare R2 控制台先建好）：
R2_BUCKET=nexus-checkpoints                   # 统一 R2 桶名
# 另建：nexus-skills（Skills 备份）、nexus-vectors（向量文件）

# ── Supabase ──
SUPABASE_URL=https://<id>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 直连串：Supabase → Settings → Database → Connection string → URI(6543 transaction pooler)
# 用于 langgraph AsyncPostgresSaver。底层用 psycopg3 且 from_conn_string 硬编码
# prepare_threshold=0（禁 server-side prepared statement），所以 6543 transaction pooler 安全。
# 勿用 5432 session pooler（连接数受限、不随负载横向扩，生产选 6543）。
# checkpointer.db_uri() 会自动补 sslmode=require（若 URI 未显式带 sslmode）；Supabase pooler 本就强制 TLS，这里显式补是纵深防御。
SUPABASE_DB_URI=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Hugging Face ──
HF_TOKEN=
# 注意:勿用 SPACE_AUTHOR_NAME / SPACE_REPO_NAME 等 SPACE_* 前缀变量 — HF 系统独占,
#   填进 HF Secrets 触发 `configuration error: Reserved environment variables`。
#   owner 靠 HF_OWNER 一条;repo/bucket 名靠 NEXUS_LOGIC_BUCKET(start.sh bootstrap fallback 用)。
HF_OWNER=                    # sync-logic-bucket 推 bucket namespace + start.sh bootstrap fallback 拉 bucket owner(如 sonoke)
NEXUS_LOGIC_BUCKET=logic     # bootstrap fallback 拉 bucket 名(正常路径靠 Volume 挂载直读,此仅兜底)

# ── Nexus 内部 ──
NEXUS_API_KEY=
# 本地开发免鉴权设 dev；生产必留空（fail-closed：缺 key 拒绝）
NEXUS_AUTH_MODE=
GATEWAY_URL=
LANGGRAPH_URL=https://<owner>-langgraph.hf.space
CLAUDE_URL=https://<owner>-claude-code.hf.space
CODEX_URL=https://<owner>-codex.hf.space

# ── Hermes Space 增强后台（可选）──
KEEPALIVE_ENABLED=0                  # 1=启动 keepalive.py 探测下游
KEEPALIVE_INTERVAL_BASE=600          # 保活基本间隔(秒)
KEEPALIVE_INTERVAL_JITTER=180        # 随机抖动±秒(避免固定周期)
SYNC_INTERVAL_SEC=300                # persist_to_r2.py 快照间隔(秒)
REPLAY_LOG=/app/installed_packages.log  # replay_packages.py 日志路径

# ── 下游模型（各 Space 按需，claude-code/codex Space 直接调上游 API 用）──
ANTHROPIC_API_KEY=        # claude-code Space 直调 Anthropic API(上游 Messages 协议)。非 hermes 用。
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=           # codex Space 直调 OpenAI API 上游用
OPENAI_BASE_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-4o-mini

# ── Hermes Agent 内核(NousResearch hermes-agent,spaces/hermes/ 换装)— 主推理 provider ──
# provider=zai(hermes 原生 plugins/model-providers/zai,专给 GLM/智谱)。OpenAI /v1/chat/completions
#   兼容协议 + Bearer 鉴权(非 anthropic Messages x-api-key)。glm-5.2 走此。
#   模型名含 glm → hermes 静态路由(models.py:1278 glm→zai)→ 查 GLM/ZAI/Z_AI key → 缺则报
#   `No usable credentials found for provider 'zai'. Set GLM_API_KEY,ZAI_API_KEY,Z_AI_API_KEY.`
# omniroute = 第 5 HF Space `nonoke/omn`(独立账号独立 Space 跑通,非仓内组件)。
#   omniroute 协议:OpenAI /v1/chat/completions + /v1/responses + Bearer(API key validateBearerApiKey),
#   非 anthropic Messages(此前误判 anthropic Messages 已证伪)。
#   hermes anthropic provider 的 base_url override 受白名单(*.anthropic.com /path-含-/anthropic),
#   hf.space 域过不去 + head x-api-key vs omniroute Bearer 错配 → anthropic 路死。走 zai。
# 真值经 HF Space Secrets 注入,不入 git(URL 公开端点非敏感可入文,key 必须 Secrets)。
GLM_API_KEY=                                     # omniroute Bearer key(= zai api_key);HF Space Secrets 注,不入 git
GLM_BASE_URL=https://nonoke-omn.hf.space/v1      # omniroute 入口;zai base_url override 必带 /v1(OpenAI client 拼 /chat/completions)
HERMES_MODEL=glm-5.2                             # 原生仅 cron scheduler 读取(cron/scheduler.py:3158);交互/oneshot 不读此
                                                 #   当默认模型。cron 优先级:per-job override > cron.model > HERMES_MODEL
                                                 #   env > config.yaml model.default。交互默认模型靠 config.yaml model.default
                                                 #   (本模板 L35,即 cron 兜底 + 交互默认)。glm-5.2 含 glm 触发 provider=zai
                                                 #   静态路由(models.py:1278)→ 查 GLM/ZAI/Z_AI key。zai 不读 ANTHROPIC_API_KEY。
                                                 #   key 经 GLM_API_KEY env 注(非 yaml 配,见 plugins/model-providers/zai/auth.py:243)。
HERMES_HOME=/data/.hermes                         # hermes-agent state.db 唯一 env 重定向开关(hermes_constants.py:64);
                                                 #   state.db = $HERMES_HOME/state.db(hermes_state.py:236)。base 镜像 ENV 固化可覆盖。

# ── dashboard 鉴权(原生 BasicAuthProvider,HF 公网 7860 须密码闸门)──
# 启用条件:0.0.0.0 绑非 loopback → should_require_auth=True → gate 开 → list_providers() 检查
#   → basic plugin(kind: backend bundled 自动加载,plugins/dashboard_auth/basic/)requires_env=
#   USERNAME 通过 + 内检 password 非空 → 注册 → /login 密码表单(scrypt 哈希 + HMAC stateless
#   cookie,无 OAuth/IDP/DB)。五个 env 全在 basic/__init__.py 读(USERNAME:408 / PASSWORD:414,451
#   / PASSWORD_HASH:411 / SECRET:372 / TTL_SECONDS:417);requires_env(plugin.yaml:6)只声明 USERNAME。
#   缺 USERNAME 或 PASSWORD → list_providers() 空 → gate SystemExit("Refusing to bind...")
#   fail-closed 拒起。secret 须设固定值(默认随机重启失效 session)。
#   env 优先于 config.yaml dashboard.basic_auth.*;此处走 env 全靠 HF Secrets 注。
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=            # HF Space Secrets 注;缺则 basic 不加载 gate 拒起
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=            # HF Space Secrets 注;明文密码(运行时内存哈希)或配 password_hash(二选一)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=              # HF Space Secrets 注;固定随机 base64/hex(≥32 字节,跨重启保 session;勿随机否则重启掉线)
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=     # 可选;预生成 scrypt 哈希替明文 password(勿与 PASSWORD 同填)
# HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=       # 可选;session TTL 秒(缺省走 plugin 默认值),跨重启保活靠固定 secret 而非此

# ── 全原生三组件触发器 ──
# api_server adapter 真触发器 = API_SERVER_KEY ≥16 字符(非 API_SERVER_ENABLED deprecated)。
#   读后端 /v1/runs 的客户端须带 Authorization: Bearer <API_SERVER_KEY>(同 key 触发 + 鉴权一石二鸟)。
#   缺失则 app.main:boot dev 兜底自生成随机串(本地测);生产 HF 必经 Secret 注真值。
API_SERVER_KEY=                                   # ≥16 字符随机串;原生触发器(gateway/config.py:2131 读 + :823 ≥16 强度门 + api_server.py:6712 无 key 拒起);HF Space Secrets 注,不入 git
DASHBOARD_BIND_HOST=0.0.0.0                       # nexus 自造 env(main.py:83 读,非 hermes 原生 — 原生无 DASHBOARD_BIND_*);
                                                 #   传 `hermes dashboard --host $值` CLI flag(dashboard.py:30 default 127.0.0.1)。
                                                 #   HF 公网须 0.0.0.0(非 loopback)→ gate 开 → basic provider 接管;本地测设 127.0.0.1 免 gate。
PORT=7860                                         # nexus 自造 env(main.py:84 读,非 hermes 原生 — 原生 dashboard 不读 PORT env,
                                                 #   CLI `--port` default 9119,dashboard.py:27)。传 `hermes dashboard --port $值` CLI flag。
                                                 #   HF 平台要求监听 7860 公网域 → dashboard 直监听(非反代)。
                                                 #   注:API server 有自己 API_SERVER_PORT env(默认 8642,config.py:2133),与此 PORT 无关。

# ── IM 平台(telegram/discord,K-R7 HF DNS 封靠 hermes 原生 telegram_network.py DoH+fallback IP 自解)──
# telegram 靠 hermes 原生 DoH 零配置自动解 DNS 封;discord 硬编无 base_url 开关仅 DISCORD_PROXY env 兜底。
TELEGRAM_BOT_TOKEN=                               # HF Space Secrets 注
DISCORD_BOT_TOKEN=                                # HF Space Secrets 注
DISCORD_PROXY=                                    # discord DNS/IP 封兜底(HTTP/SOCKS transit proxy)
TELEGRAM_PROXY=                                   # telegram IP 封 fallback(主路 DoH 已解 DNS 封;此供 IP 封)
