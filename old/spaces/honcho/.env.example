# Nexus Honcho 环境变量模板(2026-08-03)
# 真值不提交!用 HF Space Secrets 注入。复制为 .env 本地测试,.env 已 gitignore。
# 实证源:src/config.py settings 类 env_prefix + src/config.py:484 _default_embedding_api_key。
#
# 顶层 `LLM_OPENAI_BASE_URL` 存在(config.py:716)但各 feature(DERIVER/SUMMARY/EMBEDDING
# 等)的 resolve_model_config 只读 `__OVERRIDES__BASE_URL`(config.py:467),不回退顶层。
# 故每 feature 须显式 `__MODEL_CONFIG__OVERRIDES__BASE_URL` 指 omn。
# API key:openai transport 时 `_default_embedding_api_key` 回退 `LLM_OPENAI_API_KEY`(单源,
# config.py:487),不需每 feature 设 `__OVERRIDES__API_KEY`。

# ── DB:Neon serverless Postgres + pgvector(独立项目 sonoke-honcho,与 nexus Supabase 隔离)──
# init_db() 首启自动 CREATE EXTENSION vector + CREATE SCHEMA + alembic upgrade head。
# DSN 必带 sslmode=require(Neon serverless psycopg3 ssl);用 pooled endpoint(-pooler)。
# SQLAlchemy 形式前缀:postgresql+psycopg://(非 postgres://)。
DB_CONNECTION_URI=postgresql+psycopg://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# DB_SCHEMA=public                # 可选;default public(config.py:651 DBSettings)
# DB_CONNECT_TIMEOUT_SECONDS=30   # Neon scale-to-zero 冷启 wake 5-30s,默认 2s(config.py:690)必 timeout expired。
#                                   # H-7.1 首跑实证 timeout expired 根因之一。调 30 给 wake 窗口(diag 见 DESIGN-RATIONALE §N6)。

# ── LLM API key(omniroute Bearer,单源)──
# omniroute = 第 5 HF Space nonoke/omn,OpenAI 兼容端点 https://nonoke-omn.hf.space/v1
# openai transport 的 DERIVER/SUMMARY/EMBEDDING/DREAM/DIALECTIC 各 feature 自动复用此 key。
# anthropic/gemini transport 不读此 key(本部署默认全 openai transport 走 omn,故此一条够)。
LLM_OPENAI_API_KEY=
# LLM_OPENAI_BASE_URL=            # 顶层存在但不被 feature 读;不设(走每 feature __OVERRIDES__BASE_URL)

# ── 鉴权(HF 公网必开)──
# AUTH_USE_AUTH=false 时(security.py)所有 /v3/* 路由裸奔读写 admin JWT。HF 公网必开。
# USE_AUTH=true 且 JWT_SECRET 空 → config.py:689 raise 拒起(fail-closed)。
# JWT_SECRET 须固定长随机(≥32 字节,跨重启保 session);用 scripts/generate_jwt_secret.py 生成。
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=
# 生成:docker run --rm -e AUTH_JWT_SECRET=<同> honcho-hf-local python scripts/generate_jwt_secret.py

# ════════════════════════════════════════════════════════════════════
# LLM routing(每 feature base_url 指 omniroute,api key 复用 LLM_OPENAI_API_KEY)
# 每组三键:TRANSPORT + MODEL + OVERRIDES__BASE_URL;其余键 env override 后自动 fill default。
# 实证:config.py:517 _fill_defaults_for_nested_field — partial env dict 自动补 default。
# ════════════════════════════════════════════════════════════════════

# ── 模型选型:占位 gpt-5.4-mini / text-embedding-3-small 换 NVIDIA NIM 免费模型 ──
# omniroute 上游 = NIM key pool(NIM_KEYS env,模型名透传到 integrate.api.nvidia.com)。
# 故 model id 用 NIM 原生名(含 provider 前缀),base_url 仍指 omn 不动。
# honcho openai 后端 NIM 兼容已核证:
#   - openai.py:73 _uses_max_completion_tokens 仅 gpt-5*/o-series 用 max_completion_tokens,
#     NIM llama/qwen/mistral 走 max_tokens(NIM 兼容)。
#   - openai.py:209 tiktoken encoding_for_model 失败回退 cl100k_base 不崩。
# 文本生成模型档(三档,omn 面板三模型都须激活;未激活 → model_not_found):
#   主选 deepseek-ai/deepseek-v4-flash(284B/13B active MoE,中文母语 Chinese-SimpleQA 评证+structured JSON 原生+
#         agent/tool 原生无 thinking 限制+0731 最 new 增量更强 agent/coding/tool+build.nvidia.com 常青活跃 2M calls/30d;
#         v3 系入 Alibaba 2026-10-10 弃表但 v4 系未入;honcho=用户记忆 provider hermes 用户场景中文为主故定 V4 Flash 主)。
#   备用1 nvidia/nemotron-3-nano-30b-a3b(30B 全/3.5B active MoE,省 active+reasoning+structured 命中 deriver;tool caller 需 thinking off 官认证⚠️)。
#   备用2 nvidia/llama-3.1-nemotron-nano-8b-v1(8B 极省限速兜底,~40 RPM 免费档高频轮询防撞;中文不支持致命缺陷纯英文限)。
# ⚠️ honcho 经 omn 远程调 NIM(GPU 推理在 integrate.api.nvidia.com),非 HF CPU 本地跑模型 —
#    故约束 = omn 面板激活 + ~40 RPM + API 超时,非 HF RAM/CPU。前序「HF CPU-basic 友」误判已推翻。
# 嵌入:R1 实测定 nvidia/nv-embedqa-e5-v5(omn /v1/embeddings HTTP 200,dim=1024 匹配 Neon 列,中文通)。
#   ⚠️ nv-embedqa-e5-v5 拒 dimensions 截断参数(非 matryoshka),honcho 须设 DIMENSIONS_MODE=never
#   见下方降级路注 — 不传 dimensions,honcho 取 omn 原生 1024,与 EMBEDDING_VECTOR_DIMENSIONS=1024 校验过门。
# 候选见 spaces/honcho/DESIGN-RATIONALE.md §NIM + 实测矩阵。

# ── DERIVER(主派生 worker,处理 message 派 representation)──
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=deepseek-ai/deepseek-v4-flash
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1

# ── SUMMARY(消息攒到阈值触发短/长摘要)──
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=deepseek-ai/deepseek-v4-flash
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1

# ── DIALECTIC(多级 dialectic 推理,hermes 走 minimal 一级)──
# 只设 minimal(其余 level 会 backfill 默认 model+openai 但 base_url 不继承,触发其他 level 指官方 OpenAI → 401)。
# 扩他 level 再补同形态 DIALECTIC_LEVELS__<level>__MODEL_CONFIG__*。
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=deepseek-ai/deepseek-v4-flash
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1

# ── DREAM(deduction + induction 两 specialist,周期性 idle dream 阶段触发)──
# DREAM_ENABLED default true;首启无文档阈值不触发,但 idle_timeout 后可能 idle dream。
# 省心首版可关:DREAM_ENABLED=false(见下关省段)。开则两 specialist 都须设 base_url。
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=deepseek-ai/deepseek-v4-flash
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=deepseek-ai/deepseek-v4-flash
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1

# ── Embedding(R1 闸门已实测定:走 omniroute nv-embedqa-e5-v5)──
# EMBEDDING_VECTOR_DIMENSIONS 必须匹配 embedding 模型实际输出 dim,否则
# validate_embedding_schema(startup/embedding_validator.py:61)fail-closed 拒起。
# nvidia/nv-embedqa-e5-v5 → 1024(R1 实测 omn /v1/embeddings 返 1024 维,中文通)。
# 首启 migrate 建表 vector(1536) 硬编列 → launcher _configure_embeddings ALTER 1536→1024 → validate 过门。
# 切模型若 dim 变须重配(重跑 configure_embeddings 或手动 ALTER 列)。
#
# send_dimensions(config.py:773 resolve_send_dimensions):
#   模型不在 _EMBEDDING_KNOWN_REJECTING_MODELS(config.py:30,仅 text-embedding-ada-002)
#   且 EMBEDDING_VECTOR_DIMENSIONS 显式设 → auto 路默认传 dimensions=N 给 omn。
#   ⚠️ R1 实测:nv-embedqa-e5-v5 拒 dimensions 截断(HTTP 400 KeyError data,非 matryoshka 不支持截断)。
#
# 降级路(零改源,R1 实测激活):EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=never
#   强制不传 dimensions(config.py:348 字段 auto/always/never,resolve_send_dimensions
#   never→send_dimensions=False→honcho 取 omn 原生 1024,与 EMBEDDING_VECTOR_DIMENSIONS=1024 校验过门)。
#   nv-embedqa-e5-v5 固定 1024 不截断,故必须 never。
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://nonoke-omn.hf.space/v1
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=never
EMBEDDING_VECTOR_DIMENSIONS=1024

# ════════════════════════════════════════════════════════════════════
# 关省(省进程/端口/外部调用)
# ════════════════════════════════════════════════════════════════════

# CACHE:default false(config.py:1213),单进程无共享需求。省 Redis 进程。
# init_cache(main.py:119/queue_manager:1136)try/except 容错,关了仅 warning 不崩。
CACHE_ENABLED=false
# CACHE_URL=redis://localhost:6379/0?suppress=true   # 关后不读

# METRICS:default false(config.py:1145)。deriver __main__.py:88 if ENABLED 起 9090。
# 关掉 zero-overhead,省 HF 单进程多端口对外无价值。
METRICS_ENABLED=false

# TELEMETRY:default false(config.py:1159)。CloudEvents 外发关。
TELEMETRY_ENABLED=false

# SENTRY:default false(config.py:697)。错误上报关。
SENTRY_ENABLED=false

# DREAM:省心首版关(省了两 specialist LLM 调用,无 idle dream)。
# 关后 deriver 仍跑(main dialectic/summary/reconciler),仅 dream 阶段跳。
# 想用 dream 则删此行 + 上面两 specialist env 在位。
DREAM_ENABLED=false

# ════════════════════════════════════════════════════════════════════
# 可选
# ════════════════════════════════════════════════════════════════════
# LOG_LEVEL=INFO               # 部署期 Debug 改 DEBUG
# CORS_ORIGINS=["http://localhost:3000"]   # hermes 跨域调需加 hermes Space 域;default localhost+api.honcho.dev
# VECTOR_STORE_TYPE=pgvector   # default pgvector(Neon 走 pgvector 对路),不需设

# ════════════════════════════════════════════════════════════════════
# 降级路(R1 失败后:embedding 改独立供应商,deriver/summary/dialectic/dream 仍走 omn)
# ════════════════════════════════════════════════════════════════════
# 若 omn /v1/embeddings 不可用(404/401/模型不在/维度非 1024):
#   EMBEDDING_MODEL_CONFIG__MODEL=<独立供应商模型名>
#   EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=<独立供应商 base_url>
#   EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=EMBEDDING_API_KEY   # 指向独立 env 名
#   EMBEDDING_API_KEY=<独立供应商 key>           # 加此 HF Secret
#   EMBEDDING_VECTOR_DIMENSIONS=<匹配新模型 dim>
# 注:__OVERRIDES__API_KEY_ENV 指向 env 变量名(config.py resolve_embedding_model_config:497
#   _resolve_secret(api_key, api_key_env))。omn 主线不设此(走 _default_embedding_api_key 回退)。
