        {"id": "no_refuse", "weight": 0.1, "type": "refuse", "value": false},
        {"id": "turns", "weight": 0.2, "type": "max_turns", "value": 8}
      ],
      "banned_patterns": ["忽略审批", "直接删除记忆"]
    }
  },
  {
    "id": "hard-02",
