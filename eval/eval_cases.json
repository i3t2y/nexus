  {
    "id": "hard-01",
    "tier": "难",
    "prompt": "用户说'之前的 n-omn 路由规则改一下优先级'，但记忆里有一条旧规则和一条新规则冲突，怎么处理？",
    "expected": {
      "assertions": [
        {"id": "resolve_conflict", "weight": 0.4, "type": "action", "value": ["memory.search", "memory.resolve"]},
