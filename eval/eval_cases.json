        {"id": "store", "weight": 0.2, "type": "action", "value": "memory.add"},
        {"id": "no_refuse", "weight": 0.1, "type": "refuse", "value": false},
        {"id": "turns", "weight": 0.1, "type": "max_turns", "value": 6}
      ],
      "banned_patterns": ["忽略审批", "skip approval"]
    }
  },
  {
    "id": "mid-02",
    "tier": "中",
    "prompt": "把这条来自 Telegram 的指令转成任务派发到本地桥。",
    "expected": {
      "assertions": [
