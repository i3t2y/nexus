# Nexus Hermes Agent config 模板(K 形态,2026-08-02)
# start.sh boot 首启从本模板生成 $HERMES_HOME/config.yaml(不覆盖既有)。
# 全原生三组件:gateway(含 api_server adapter 同 loop)+ dashboard(in-proc daemon thread --port 7860)
#               + 两 plugin tab(nexus-r2 R2 文件 / nexus-ops 下游+业务表)。
#
# 关键闸门:
#   - model 段(provider=custom,官方正路,2026-08-02 源码核改):
#     omniroute = 第三方 OpenAI 兼容端点 → hermes 原生 `custom` provider
#     (cli-config.yaml.example L99 逐字 "Any other OpenAI-compatible endpoint.
#     Set base_url below",别名 ollama/vllm/llamacpp 全映射 custom)。
#     非原生 `openai` provider — openai 不信誉 base_url 覆盖走官方 api.openai.com → omniroute key 401。
#     custom 信誉 model.base_url 指 omniroute https://nonoke-omn.hf.space/v1(必带 /v1),
#     key = OPENAI_API_KEY env(omniroute Bearer key;auth.py:481 custom 进特殊集)。
#     报错 `No usable credentials found for provider 'zai'. Set GLM_API_KEY,...` = 模型名含 glm/z-ai
#     前缀 → alias 静态路由(auth.py:1909 glm→zai)→ zai provider 缺 GLM_API_KEY env。
#     解 = 模型名避开 glm 前缀(用 claude-sonnet-5)+ provider 显式 custom 绕 alias。
#   - dashboard.basic_auth 段(env 优先):HF 7860 公网绑须 BasicAuthProvider 接管鉴权(原生,
#     kind: backend 自动加载)。env HERMES_DASHBOARD_BASIC_AUTH_{USERNAME,PASSWORD,SECRET} 缺则
#     list_providers() 空 → gate SystemExit fail-closed 拒起。配齐 → /login 密码表单。
#   - API_SERVER_KEY env(≥16 字符)是 api_server adapter 真触发器(非本 yaml,见 .env.example)。
#   - platform_toolsets top-level 三行:toolset="nexus"(nexus-r2 注册的三下游 bridge tool)
#     须在此显式列各平台,plugin tool 注册(code import)≠ toolset 启用平台注入。
#   - plugins.enabled 列两 plugin license(代码 import 许可);dashboard tab 发现靠 manifest.json 不靠此项。
#   - disabled_toolsets 全局砍无头跑不起的 browser/image_gen/voice/tts。
#   - database.journal_mode: wal(K-R6:配合 base libsqlite3 ≥3.51.3 防 fresh DB 强 DELETE 致 litestream 静默 off)。

plugins:
  enabled:
    - nexus-r2
    - nexus-ops

# ── model 段:custom provider + base_url 指 omniroute(官方正路)──
# 参考 refs/hermes-agent/cli-config.yaml.example L99 逐字:
#   "custom" = "Any other OpenAI-compatible endpoint. Set base_url below."
#   别名 ollama/vllm/llamacpp 全映射 custom。
# omniroute(nonoke/omn HF Space)= 第三方 OpenAI 兼容端点 → 属 custom 非原生 openai。
# 用 custom(Bearer 鉴权 OpenAI /v1/chat/completions 兼容),读 OPENAI_API_KEY env(auth.py:481
#   custom 进特殊集)。
# ★ base_url 进 config.yaml model 段显式(非仅 env);openai 原生 provider 不信誉 base_url
#   覆盖会走官方 api.openai.com → omniroute key 401。custom 信誉 base_url。
# 模型名避开 glm/z-ai 前缀防 alias 触发 zai provider(auth.py:1909 glm→zai)。
model:
  default: claude-sonnet-5
  provider: custom
  base_url: https://nonoke-omn.hf.space/v1

# top-level(非 nested):各平台启用的 toolset 列表。
# hermes-* 是平台自带 toolset; nexus 是 nexus-r2 注册的下游 bridge toolset。
platform_toolsets:
  api_server: [hermes-api-server, nexus]
  telegram:   [hermes-telegram, nexus]
  discord:    [hermes-discord, nexus]

# 全局禁用 toolset(HF 无头无 sandbox,chromium 起不来 + 触浏览器自动化风控)。
disabled_toolsets:
  - browser
  - image_generation
  - voice
  - tts

database:
  journal_mode: wal   # K-R6 litestream 需 WAL 跟踪

# telegram/discord config(平台 adapter 由此起,凭证走 env 非 yaml):
#   TELEGRAM_BOT_TOKEN / DISCORD_BOT_TOKEN env 注。
#   HF DNS 封 IM 域(K-R7):telegram 靠 hermes 原生 telegram_network.py DoH+fallback IP 自解;
#   discord 硬编无 base_url 开关,仅 DISCORD_PROXY env 兜底。
telegram:
  enabled: true
discord:
  enabled: true
